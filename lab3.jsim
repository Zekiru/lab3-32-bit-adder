.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"


*******************************************************************************
* Full-Adder
*******************************************************************************

.subckt fa a b carry_in sum carry_out
    Xsum1 a b i xor2
    Xsum2 i carry_in sum xor2
    Xc_out1 a b j nand2
    Xc_out2 i carry_in k nand2
    Xc_out3 j k carry_out nand2
.ends


*******************************************************************************
* 32-bit Ripple Carry Adder
*******************************************************************************

.subckt add32 a[31:0] b[31:0] c0 sum[31:0] c32
    Xadd a[31:0] b[31:0] c[31:0] sum[31:0] c[32:1] fa
.ends

Xsum a[31:0] b[31:0] 0 sum[31:0] c32 add32


*******************************************************************************
* Test Cases
*******************************************************************************

Wa a[31:0] nrz(0, 5, 20ns, 0ns, 0.001ns, 0.001ns)
+ 0x00000000
+ 0x55555555
+ 0x00000000
+ 0x55555555
+ 0xFFFFFFFF
+ 0xAAAAAAAA
+ 0x00000000
+ 0xAAAAAAAA
+ 0x00000001
+ 0xFFFFFFFF

Wb b[31:0] nrz(0, 5, 20ns, 0ns, 0.001ns, 0.001ns)
+ 0x00000000
+ 0x00000000
+ 0x55555555
+ 0x55555555
+ 0xFFFFFFFF
+ 0x00000000
+ 0xAAAAAAAA
+ 0xAAAAAAAA
+ 0xFFFFFFFF
+ 0x00000001


*******************************************************************************
* Transient and Plot Commands.
*******************************************************************************

.tran 200ns
.plot L(a[31:0])
.plot L(b[31:0])
.plot L(sum[31:0])
.plot c32


